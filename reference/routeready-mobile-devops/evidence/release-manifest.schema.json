{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Release manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["application_id", "platform", "marketing_version", "build_number", "git_sha", "workflow_run_id",
               "artifact_sha256", "backend_image_digest", "api_contract_revision", "store_state", "distribution_status"],
  "properties": {
    "application_id": { "type": "string" },
    "platform": { "enum": ["ios", "android"] },
    "marketing_version": { "type": "string" },
    "build_number": { "type": "integer", "minimum": 1, "maximum": 2100000000 },
    "git_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "workflow_run_id": { "type": "string" },
    "toolchain": { "type": "object" },
    "artifact": { "type": "string" },
    "artifact_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "symbol_artifact_ids": { "type": "array", "items": { "type": "string" } },
    "backend_image_digest": { "type": "string", "description": "registry/name@sha256:..., never a tag" },
    "api_contract_revision": { "type": "string" },
    "tested_client_versions": { "type": "array", "items": { "type": "string" } },
    "feature_flag_defaults": { "type": "object" },
    "target_track": { "type": "string" },
    "approvals": { "type": "array", "items": { "type": "object" } },
    "store_state": { "enum": ["not_uploaded", "uploaded", "processing", "testers_available", "in_review", "approved", "phased_release", "staged_rollout", "paused", "halted", "released"] },
    "distribution_status": { "enum": ["packaged", "uploaded", "testing", "in_review", "rolling_out", "released", "paused"] }
  },
  "not": { "anyOf": [ { "required": ["keystore_password"] }, { "required": ["token"] }, { "required": ["private_key"] } ] }
}
